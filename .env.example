# Copy to .env and fill in. NEVER commit the real .env.
# Every name here must also exist as a GitHub Actions secret for the
# scheduled pipelines to run (Settings -> Secrets and variables -> Actions).

# ---- Data source ----
SOURCE_API_BASE_URL=https://api.example.com
SOURCE_API_KEY=changeme

# ---- Hopsworks (feature store) ----
HOPSWORKS_API_KEY=changeme
HOPSWORKS_PROJECT=changeme

# ---- Experiment tracking (optional / stretch) ----
# The model registry lives in Hopsworks alongside the feature store, so there is no
# tracking server to operate. W&B is optional if richer run comparison is wanted.
WANDB_API_KEY=changeme

# ---- Google Cloud (serving + object storage) ----
# There is deliberately no GOOGLE_APPLICATION_CREDENTIALS here, and no service-account key
# anywhere in this project. The organisation this deploys into enforces
# constraints/iam.managed.disableServiceAccountKeyCreation, so a downloadable key cannot be
# created at all — which is the correct default and not an obstacle to work around.
#
# Locally:   gcloud auth application-default login   (your own user credentials)
# On Cloud Run: the service's attached runtime service account, resolved automatically.
#
# A long-lived JSON key in a PUBLIC repository's secrets would be the wrong answer even where
# it is permitted: the blast radius is a live business organisation, not a student sandbox.
GCP_PROJECT_ID=changeme
# europe-west6 is Zurich: Tier 2 pricing, roughly 40% dearer than europe-west1 (Belgium),
# which is Tier 1 and low-CO2. At this workload the difference is cents a month, and Swiss
# data residency for a Swiss university project is the better story. Kept deliberately.
GCP_REGION=europe-west6
GCS_BUCKET=changeme

# ---- Runtime ----
LOG_LEVEL=INFO
